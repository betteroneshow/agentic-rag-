# 请将您的API密钥填入此处，并将文件名修改为 .env

# --- API Keys ---
# 通义千问 API Key
# DASHSCOPE_API_KEY="your_dashscope_api_key"

# OpenAI 或 兼容OpenAI的模型的API Key
OPENAI_API_KEY=""

# 用于网络搜索的 Tavily API Key
TAVILY_API_KEY=""

# --- Custom Endpoint ---
# 如果您使用自定义的、兼容OpenAI API的端点（例如Ollama, LocalAI等），请在此处设置其URL
# 例如: OPENAI_API_BASE="http://localhost:11434/v1"
OPENAI_API_BASE=

EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-v4
LOCAL_EMBEDDING_MODEL_PATH=BAAI/bge-m3

# qwen3-rerank 默认复用 OPENAI_API_KEY 和 OPENAI_API_BASE。
# 如果 rerank 使用独立的百炼端点或密钥，请设置下面两项。
# 工作空间示例：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-api/v1
RERANK_MODEL_NAME=qwen3-rerank
RERANK_API_KEY=
RERANK_API_BASE=
RERANK_REQUEST_TIMEOUT=60

# 混合检索各阶段的候选数量。
HYBRID_DENSE_CANDIDATES=30
HYBRID_SPARSE_CANDIDATES=30
HYBRID_RERANK_CANDIDATES=30

# 叙事文档递归字符分块参数。
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200
# 子块仅用于召回；命中后返回其所属的 1000 字符父块。
RETRIEVAL_CHUNK_SIZE=350
RETRIEVAL_CHUNK_OVERLAP=50

# 上下文压缩和短期记忆摘要。
CONTEXT_COMPRESS_THRESHOLD=12000
CONTEXT_TARGET_CHARS=8000
CONVERSATION_SUMMARY_START_TURNS=10
CONVERSATION_SUMMARY_INTERVAL=5
CONVERSATION_RECENT_TURNS=5

# qwen3.5-ocr：默认复用 OPENAI_API_KEY 和 OPENAI_API_BASE。
OCR_MODEL_NAME=qwen3.5-ocr
OCR_API_KEY=
OCR_API_BASE=
OCR_REQUEST_TIMEOUT=180
OCR_MAX_RETRIES=3
OCR_MAX_TOKENS=16384
OCR_PDF_DPI=160

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT=pr-monthly-ecclesia-53
OPENAI_API_KEY=<your-openai-api-key>
